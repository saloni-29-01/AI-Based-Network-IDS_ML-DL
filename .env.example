# Copy to .env and adjust. Every value is optional - these are the defaults.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Paths (relative to the project root unless absolute)
NSL_KDD_DIR=nsl-kdd
DATA_DIR=data
MODEL_PATH=models
REPORT_DIR=reports
LOG_DIR=logs
DATABASE_URL=sqlite:///data/ids.db

# Live capture (leave CAPTURE_INTERFACE empty for Scapy's default interface)
CAPTURE_INTERFACE=
CAPTURE_BPF_FILTER=ip

# Flow tracker timeouts, seconds of packet time
FLOW_IDLE_TIMEOUT=10
FLOW_ACTIVE_TIMEOUT=120
FLOW_TCP_CLOSE_GRACE=1

# Broadcast/multicast flows are counted but not scored (out of the NSL-KDD domain)
SKIP_BROADCAST=true

# Detection / risk / alerting
ENSEMBLE_WEIGHTS=rf=0.6,cnn=0.4
SUSPICIOUS_THRESHOLD=0.35
SEVERITY_MAP=normal=0,Probe=50,DoS=70,R2L=85,U2R=95
ALERT_MIN_RISK=30
ALERT_DEDUP_WINDOW=30
ALERT_RATE_LIMIT=20
# Optional: POST CRITICAL alerts as JSON to an incoming webhook (Slack/Teams/Discord).
# Never commit a real webhook URL.
ALERT_WEBHOOK_URL=

# Engine for dataset simulation: empty = baseline models, gan = models retrained on
# GAN-augmented data (run scripts/train_gan.py first). The UI labels which is active.
FULL_ENGINE_VARIANT=

# Dataset simulation default rate (records per second at 1x)
SIMULATION_RATE=25
